diff --git a/backend/app/platform_metrics.py b/backend/app/platform_metrics.py
new file mode 100644
index 0000000..dfaf479
--- /dev/null
+++ b/backend/app/platform_metrics.py
@@ -0,0 +1,80 @@
+"""Platform-owned metrics around the unchanged DataScientest FastAPI app."""
+
+from time import perf_counter
+
+import psycopg
+from prometheus_client import CONTENT_TYPE_LATEST, Counter, Histogram, generate_latest
+from starlette.responses import Response
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+from app.core.config import settings
+from app.main import app
+
+REQUESTS = Counter(
+    "http_requests_total", "HTTP requests", ["method", "handler", "status"]
+)
+DURATION = Histogram(
+    "http_request_duration_seconds", "Full HTTP request duration", ["method", "handler"]
+)
+
+
+class MetricsMiddleware:
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http" or scope.get("path") == "/metrics":
+            await self.app(scope, receive, send)
+            return
+        status = 500
+        started = perf_counter()
+
+        async def capture_status(message: Message) -> None:
+            nonlocal status
+            if message["type"] == "http.response.start":
+                status = message["status"]
+            await send(message)
+
+        try:
+            await self.app(scope, receive, capture_status)
+        finally:
+            # Route templates, not user-controlled URLs, bound label cardinality.
+            handler = str(getattr(scope.get("route"), "path", "unmatched"))
+            method = str(scope.get("method", "OTHER"))
+            if method not in {
+                "GET",
+                "POST",
+                "PUT",
+                "PATCH",
+                "DELETE",
+                "HEAD",
+                "OPTIONS",
+            }:
+                method = "OTHER"
+            REQUESTS.labels(method, handler, str(status)).inc()
+            DURATION.labels(method, handler).observe(perf_counter() - started)
+
+
+def metrics() -> Response:
+    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)
+
+
+def readiness() -> Response:
+    try:
+        with psycopg.connect(
+            host=settings.POSTGRES_SERVER,
+            port=settings.POSTGRES_PORT,
+            dbname=settings.POSTGRES_DB,
+            user=settings.POSTGRES_USER,
+            password=settings.POSTGRES_PASSWORD,
+            connect_timeout=2,
+        ) as connection:
+            connection.execute("SELECT 1").fetchone()
+        return Response("ready")
+    except psycopg.Error:
+        return Response("database unavailable", status_code=503)
+
+
+app.add_middleware(MetricsMiddleware)
+app.add_api_route("/metrics", metrics, tags=["platform"], include_in_schema=False)
+app.add_api_route("/readyz", readiness, tags=["platform"], include_in_schema=False)
